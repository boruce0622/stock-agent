APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=9010
DATABASE_URL=sqlite+aiosqlite:///./data/stock_agent.db
CORS_ORIGINS=http://localhost:6173
LOG_LEVEL=INFO
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# 以下是模型运行参数；供应商、模型和 API Key 在前端“AI 设置”中管理。
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
